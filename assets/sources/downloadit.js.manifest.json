{
  "id": "downloadit",
  "name": "Download.it",
  "version": "1.1.0",
  "homepage": "https://en.download.it/",
  "description": "Reads Android app search, details, screenshots, and APK download items from Download.it.",
  "permissions": {
    "network": [
      "download.it",
      "en.download.it",
      "*.en.download.it",
      "static.download.it",
      "dl.download.it",
      "cdn.ditdlm.com"
    ],
    "browser": true,
    "download": true,
    "install": false
  },
  "capabilities": {
    "catalog": true,
    "detailProgress": true,
    "packageLookup": false
  },
  "debugProjects": [
    {
      "id": "search-keyword",
      "name": "Search Keywords",
      "description": "Search Android apps via Download.it.",
      "inputLabel": "Keyword",
      "placeholder": "e.g. traps",
      "defaultInput": "traps"
    },
    {
      "id": "app-details",
      "name": "Get App Details",
      "description": "Reads detail page metadata, screenshots, and APK download links.",
      "inputLabel": "App Details URL",
      "placeholder": "Paste *.en.download.it/android URL",
      "defaultInput": "https://trap-beats.en.download.it/android"
    }
  ]
}
